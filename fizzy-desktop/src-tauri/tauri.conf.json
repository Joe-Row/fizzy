{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fizzy",
  "version": "0.1.0",
  "identifier": "com.nimue.fizzy",
  "build": {
    "frontendDist": "http://127.0.0.1:3000",
    "devUrl": "http://127.0.0.1:3000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "url": "http://127.0.0.1:3000",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "focus": true,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#2A333C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Fizzy board shell",
    "longDescription": "Native window for the local Fizzy board (Docker on :3000).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
